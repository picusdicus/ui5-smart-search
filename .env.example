# Groq API (LLM calls)
GROQ_API_KEY=gsk_your-key-here

# HuggingFace Inference API (embeddings)
HF_API_KEY=hf_your-token-here

# SAP HANA Cloud (from BTP service key)
HANA_HOST=your_hana_host.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=DBADMIN
HANA_PASSWORD=your_hana_password_here

# SAP API Hub (S/4HANA Cloud sandbox or productive)
API_HUB_KEY=
API_HUB_BASE_URL=https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/API_BUSINESS_PARTNER
