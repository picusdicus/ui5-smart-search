-- Embedding dimensions: 768 (nomic-embed-text via Ollama)
-- ============================================================
-- CV_CUSTOMERS_SEARCH
-- Exposes Customers with REAL_VECTOR(768) embedding column.
-- Usage: SELECT *, COSINE_SIMILARITY(EMBEDDING, TO_REAL_VECTOR(?)) AS SCORE
--        FROM CV_CUSTOMERS_SEARCH ORDER BY SCORE DESC LIMIT 10
--        (? = JSON array of 768 floats produced by nomic-embed-text)
-- ============================================================
VIEW "CV_CUSTOMERS_SEARCH" AS
SELECT
  "ID",
  "NAME",
  "EMAIL",
  "PHONE",
  "ADDRESS",
  "COUNTRY",
  "CREATEDAT",
  "CREATEDBY",
  "MODIFIEDAT",
  "MODIFIEDBY",
  "EMBEDDING"
FROM "smart_search_Customers";

-- ============================================================
-- CV_PRODUCTS_SEARCH
-- ============================================================
VIEW "CV_PRODUCTS_SEARCH" AS
SELECT
  "ID",
  "NAME",
  "DESCRIPTION",
  "CATEGORY",
  "PRICE",
  "CURRENCY",
  "STOCK",
  "CREATEDAT",
  "CREATEDBY",
  "MODIFIEDAT",
  "MODIFIEDBY",
  "EMBEDDING"
FROM "smart_search_Products";

-- ============================================================
